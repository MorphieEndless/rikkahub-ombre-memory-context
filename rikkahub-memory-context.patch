@@ -0,0 +1,193 @@
+package me.rerere.rikkahub.data.ai.mcp
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import me.rerere.ai.core.MessageRole
+import me.rerere.ai.ui.UIMessage
+import me.rerere.ai.ui.UIMessagePart
+import me.rerere.rikkahub.data.model.Conversation
+import me.rerere.rikkahub.data.model.MessageNode
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.uuid.Uuid
+
+class MemoryWriteContextTest {
+
+    private fun user(text: String) = UIMessage(
+        role = MessageRole.USER,
+        parts = listOf(UIMessagePart.Text(text)),
+    )
+
+    private fun assistant(text: String) = UIMessage(
+        role = MessageRole.ASSISTANT,
+        parts = listOf(UIMessagePart.Text(text)),
+    )
+
+    private fun conversation(vararg nodes: MessageNode): Conversation {
+        return Conversation(
+            id = Uuid.random(),
+            assistantId = Uuid.random(),
+            messageNodes = nodes.toList(),
+            title = "test",
+        )
+    }
+
+    private fun nodeOf(vararg messages: UIMessage): MessageNode {
+        return MessageNode(messages = messages.toList())
+    }
+
+    // ------------------------------------------------------------
+    // anchor 解析
+    // ------------------------------------------------------------
+    @Test
+    fun `normal message anchors to last user node`() {
+        val conv = conversation(
+            nodeOf(user("你好")),
+            nodeOf(assistant("你好呀")),
+            nodeOf(user("今天考试")),
+        )
+        val anchor = resolveAnchorNodeId(conv, null)
+        assertNotNull(anchor)
+        assertEquals(conv.messageNodes[2].id, anchor)
+    }
+
+    @Test
+    fun `assistant reroll anchors to preceding user node`() {
+        val conv = conversation(
+            nodeOf(user("第一次提问")),
+            nodeOf(assistant("第一次回答"), assistant("第二次回答")),
+            nodeOf(assistant("后续消息")),
+        )
+        val anchor = resolveAnchorNodeId(conv, 0 until 2)
+        assertNotNull(anchor)
+        assertEquals(conv.messageNodes[0].id, anchor)
+    }
+
+    @Test
+    fun `user reroll anchors to the truncated user node`() {
+        val conv = conversation(
+            nodeOf(user("原始提问")),
+        )
+        val anchor = resolveAnchorNodeId(conv, null)
+        assertEquals(conv.messageNodes[0].id, anchor)
+    }
+
+    @Test
+    fun `no user node yields null anchor`() {
+        val conv = conversation(nodeOf(assistant("孤儿回复")))
+        assertNull(resolveAnchorNodeId(conv, null))
+    }
+
+    // ------------------------------------------------------------
+    // reroll 代数
+    // ------------------------------------------------------------
+    @Test
+    fun `reroll generation counts existing branches`() {
+        val conv = conversation(
+            nodeOf(user("提问")),
+            nodeOf(assistant("回答一"), assistant("回答二"), assistant("回答三")),
+        )
+        val generation = resolveRerollGeneration(conv, 0 until 1)
+        assertEquals(3, generation)
+    }
+
+    @Test
+    fun `normal message has reroll generation zero`() {
+        val conv = conversation(nodeOf(user("提问")))
+        assertEquals(0, resolveRerollGeneration(conv, null))
+    }
+
+    // ------------------------------------------------------------
+    // 上下文构建
+    // ------------------------------------------------------------
+    @Test
+    fun `build context carries stable conversation and anchor`() {
+        val conv = conversation(
+            nodeOf(user("提问")),
+            nodeOf(assistant("回答")),
+        )
+        val ctx = buildMemoryWriteContext(conv, 0 until 1)
+        assertNotNull(ctx)
+        ctx!!
+        assertEquals("rikkahub", ctx.client)
+        assertEquals(conv.id.toString(), ctx.conversationId)
+        assertEquals(conv.messageNodes[0].id.toString(), ctx.anchorNodeId)
+        assertTrue(ctx.generationId.isNotBlank())
+        assertEquals(0, ctx.rerollGeneration)
+    }
+
+    // ------------------------------------------------------------
+    // 注入
+    // ------------------------------------------------------------
+    @Test
+    fun `injects only into write tools when injection enabled`() {
+        val ctx = MemoryWriteContext(
+            client = "rikkahub",
+            conversationId = "11111111-1111-4111-8111-111111111111",
+            anchorNodeId = "22222222-2222-4222-8222-222222222222",
+            generationId = "33333333-3333-4333-8333-333333333333",
+            rerollGeneration = 2,
+        )
+        val raw = buildJsonObject {
+            put("content", "测试内容")
+        }
+
+        // 开启注入：服务端已接入 receipt 幂等的 hold/grow 才会注入；
+        // plan/letter_write 尚未定义服务端复用语义，必须保持原样。
+        assertTrue("client_write_context" in injectMemoryWriteContext(raw, "hold", ctx, injectionEnabled = true))
+        assertTrue("client_write_context" in injectMemoryWriteContext(raw, "grow", ctx, injectionEnabled = true))
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "plan", ctx, injectionEnabled = true))
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "letter_write", ctx, injectionEnabled = true))
+        // 只读工具不注入
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "breath", ctx, injectionEnabled = true))
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "breath_search", ctx, injectionEnabled = true))
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "pulse", ctx, injectionEnabled = true))
+        // 未显式开启注入的 Server：即使工具名匹配也不注入
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "hold", ctx, injectionEnabled = false))
+        // 没有锚点（context = null）：原样透传
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "hold", null, injectionEnabled = true))
+    }
+
+    @Test
+    fun `injection overrides model supplied context`() {
+        val ctx = MemoryWriteContext(
+            client = "rikkahub",
+            conversationId = "11111111-1111-4111-8111-111111111111",
+            anchorNodeId = "22222222-2222-4222-8222-222222222222",
+            generationId = "33333333-3333-4333-8333-333333333333",
+            rerollGeneration = 2,
+        )
+        val modelSpoofed = buildJsonObject {
+            put("client_write_context", buildJsonObject {
+                put("client", "evil")
+                put("conversation_id", "00000000-0000-4000-8000-000000000000")
+            })
+        }
+        val injected = injectMemoryWriteContext(modelSpoofed, "hold", ctx, injectionEnabled = true)
+        val injectedCtx = injected["client_write_context"] as JsonObject
+        assertEquals("rikkahub", injectedCtx["client"]!!.toString().trim('"'))
+        assertEquals(
+            "11111111-1111-4111-8111-111111111111",
+            injectedCtx["conversation_id"]!!.toString().trim('"'),
+        )
+    }
+
+    @Test
+    fun `injection requires explicit config enable`() {
+        val ctx = MemoryWriteContext(
+            client = "rikkahub",
+            conversationId = "11111111-1111-4111-8111-111111111111",
+            anchorNodeId = "22222222-2222-4222-8222-222222222222",
+            generationId = "33333333-3333-4333-8333-333333333333",
+            rerollGeneration = 0,
+        )
+        val raw = buildJsonObject { put("content", "x") }
+        // 默认关闭：不凭显示名/URL 猜测，未显式开启一律不注入
+        assertFalse("client_write_context" in injectMemoryWriteContext(raw, "hold", ctx, injectionEnabled = false))
+    }
+}
